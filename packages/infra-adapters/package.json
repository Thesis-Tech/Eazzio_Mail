{
  "name": "@eazzio/infra-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:migrate": "npx tsx ../../scripts/migrate.ts",
    "test:smtp:diag": "npx tsx -e \"import { SmtpDiagnosticRunner } from './src/email-transport/smtp-diagnostic-cli.js'; SmtpDiagnosticRunner.runDiagnostics('gmail.com').then(console.log);\""
  },

  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@eazzio/contracts": "workspace:*",
    "@eazzio/domain": "workspace:*",
    "@opensearch-project/opensearch": "^3.6.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/ioredis": "^5.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
