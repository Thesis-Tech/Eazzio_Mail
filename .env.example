# ==============================================================================
# EAZZIO MAIL — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database & Cache
DATABASE_URL=postgresql://eazzio_user:eazzio_password@localhost:5432/eazzio_mail
REDIS_URL=redis://localhost:6379

# Backend API & Web Ports
PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8081

# ------------------------------------------------------------------------------
# INBOUND MAIL CONFIGURATION (GoDaddy IMAP Inbound)
# Note: MX for eazzio.com points to mailstore1.secureserver.net (GoDaddy)
# ------------------------------------------------------------------------------
INBOUND_MAIL_PROVIDER=godaddy
INBOUND_MAIL_PROTOCOL=imap
INBOUND_MAIL_HOST=imap.secureserver.net
INBOUND_MAIL_PORT=993
INBOUND_MAIL_SECURE=true
INBOUND_MAIL_USERNAME=rahulkumar@eazzio.com
INBOUND_MAIL_PASSWORD=
INBOUND_MAIL_FOLDER=INBOX
INBOUND_MAIL_POLL_INTERVAL=60

# ------------------------------------------------------------------------------
# OUTBOUND MAIL CONFIGURATION
# Options: "postfix" (default) | "godaddy-smtp" | "mailersend"
# ------------------------------------------------------------------------------
OUTBOUND_MAIL_PROVIDER=godaddy-smtp

# GoDaddy SMTP Relay Configuration:
# - Legacy / Workspace / Titan plans: smtpout.secureserver.net (port 465, secure=true)
# - Microsoft 365 plans: smtp.office365.com (port 587, secure=false — STARTTLS)
GODADDY_SMTP_HOST=smtpout.secureserver.net
GODADDY_SMTP_PORT=465
GODADDY_SMTP_SECURE=true
GODADDY_SMTP_USERNAME=rahulkumar@eazzio.com
GODADDY_SMTP_PASSWORD=

# Fallback Generic / Brevo SMTP Relay (if using "postfix" or standard relay)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=b64c83001@smtp-brevo.com
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_NAME="Rahul Kumar (Eazzio Mail)"
SMTP_FROM_EMAIL=kumarrahulraj468@gmail.com

# ------------------------------------------------------------------------------
# LMTP Inbound Daemon (Local / Internal Routing)
# ------------------------------------------------------------------------------
LMTP_HOST=127.0.0.1
LMTP_PORT=2424

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3 / Local Memory)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=memory
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=eazzio-mail-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
