# Node Environment
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://eazzio_user:eazzio_password@localhost:5432/eazzio_mail

# Cache Configuration (Valkey / Render KV)
VALKEY_URL=redis://localhost:6379

# Object Storage (MinIO / Cloudinary)
STORAGE_DRIVER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=eazzio_admin
MINIO_ROOT_PASSWORD=eazzio_secret_key

# Search (OpenSearch)
OPENSEARCH_NODE=http://localhost:9200

# JWT & Authentication Secrets
JWT_SECRET=super_secret_dev_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# SMTP & Mail Transport
SMTP_HOST=localhost
SMTP_PORT=25
