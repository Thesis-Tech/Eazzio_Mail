{
  "name": "eazzio-mail",
  "version": "0.1.0",
  "private": true,
  "description": "Eazzio Mail monorepo",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "test:coverage": "pnpm --recursive run test:coverage",
    "test:e2e": "pnpm --recursive run test:e2e",
    "build": "pnpm --recursive run build"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  }
}
