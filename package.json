{
  "name": "eazzio-mail-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive run build",
    "lint": "npx prettier --check .",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "dev": "pnpm --filter @eazzio/api start & pnpm --filter @eazzio/web dev",
    "db:migrate": "npx tsx scripts/migrate.ts",
    "mail:diag": "npx tsx scripts/diagnose-smtp.ts",
    "mail:inject": "npx tsx scripts/inject-eml.ts",
    "mail:inject:batch": "npx tsx scripts/batch-inject-eml.ts",
    "mail:poller": "npx tsx scripts/poll-inbound.ts",
    "mail:send": "npx tsx scripts/send-test-email.ts",
    "test:otp": "npx tsx scripts/test-otp-and-smtp.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

