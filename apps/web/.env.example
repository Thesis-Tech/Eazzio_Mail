# =================================================================
# Meta / Facebook JavaScript SDK & WhatsApp Cloud API Configuration
# =================================================================

# 1. Facebook App ID (from Meta Developers > App Settings)
NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id_here
NEXT_PUBLIC_FACEBOOK_API_VERSION=v21.0

# 2. WhatsApp Cloud API Credentials (from Meta Developers > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_permanent_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_waba_id

# 3. Telegram Bot Fallback (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
